} from "primitives.slint";
import { PluginRowData, PluginNavData, PluginTable } from "settings-plugins.slint";
export { PluginRowData, PluginNavData } from "settings-plugins.slint";
import { TelemetryPanel, TelemetryState, TelemetryTick } from "telemetry.slint";
export { TelemetryState, TelemetryTick } from "telemetry.slint";

export struct FieldData {
    index: int,
    label: string,
    unit: string,
    included: bool,
    value: string,
    kind: int,
    choices: [string],
    selected: int,
    info: string,
    // kind 5: slider bounds and numeric value in the row's unit (locale-independent).
    slider-min: float,
    slider-max: float,
    slider-value: float,
}
export struct GroupData { section-title: string, title: string, expanded: bool, is-per-core: bool, rows: [FieldData] }
export struct CurveNode { x: float, y: float, reference-y: float, selected: bool }
export struct CoreRow { label: string, value: string }
export struct AxisTick { position: float, label: string }

export global Workbench {
    pure callback tr(string) -> string;
    in-out property <int> page;
    in property <bool> admin;
    in property <bool> window-maximized;
    in property <bool> test-mode;
    in-out property <bool> busy;
    in-out property <bool> operation-busy;
    in-out property <bool> apply-busy;
    in-out property <string> status;
    in property <string> identity;
    in property <string> gpu-name;
    in property <string> gpu-power;
    in property <string> gpu-temp;
    in property <string> gpu-clock;
    in property <string> gpu-tgp;
    in property <string> cpu-name;
    in property <string> cpu-power;
    in property <string> cpu-temp;
    in property <string> cpu-load;
    in property <string> chassis-temp;
    in property <string> sensor-details;
    in property <string> cpu-source;
    in property <string> power-source;
    in property <string> last-apply;
    in property <[string]> profiles;
    in-out property <int> profile-index;
    in-out property <string> preset-name;
    in property <[GroupData]> groups;
    in property <[CoreRow]> cores;
    in-out property <bool> dirty;
    in property <bool> preset-ready;
    in property <bool> preset-saved;
    in property <bool> preset-applicable;
    in property <bool> recovery-pending;
    in-out property <bool> preset-startup;
    in-out property <int> fan-index;
    in-out property <int> graphics-index;
    in property <string> cooling-status;
    in property <bool> fan-library-ready;
    in property <bool> fan-library-dirty;
    in property <bool> fan-library-saved;
    in property <[string]> fan-library-names;
    in-out property <int> fan-library-index;
    in-out property <string> fan-library-name;
    in property <[string]> profile-fan-choices;
    in-out property <int> profile-fan-index;
    in property <bool> profile-fan-linked;
    in property <string> graphics-status;
    in-out property <bool> curve-open;
    in property <bool> curve-gpu;
    in property <[CurveNode]> nodes;
    in property <string> curve-path;
    in property <string> reference-path;
    in property <[AxisTick]> x-ticks;
    in property <[AxisTick]> y-ticks;
    // Plot size in logical px, reported by the canvas for tick spacing.
    in-out property <float> plot-width;
    in-out property <float> plot-height;
    // The reference line is the NVIDIA driver default curve (GPU).
    in property <bool> curve-driver-reference;
    // Offset of the whole draft from the driver default curve.
    in property <string> curve-delta;
    in property <string> curve-title;
    in property <string> curve-x-label;
    in property <string> curve-y-label;
    in-out property <string> point-x;
    in-out property <string> point-y;
    in property <[string]> point-labels;
    in-out property <int> point-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> curve-selection-mode;
    // Values of the dragged or hovered point, shown beside it; position in 0..1.
    in property <string> curve-readout;
    in property <float> readout-x;
    in property <float> readout-y;
    in property <bool> readout-hover;
    in property <bool> has-selection;
    in property <float> selection-low;
    in property <float> selection-high;
    in property <string> selection-label;
    in-out property <string> range-from;
    in-out property <string> range-to;
    in-out property <bool> lighting-on;
    in property <bool> lighting-ready;
    in property <[KeyCap]> keyboard-keys;
    in-out property <bool> keyboard-german;
    in property <int> lighting-group;
    in property <bool> lighting-dirty;
    in property <string> lighting-confirmed;
    in property <string> lighting-error;
    in-out property <string> lighting-color;
    in-out property <string> lighting-brightness;
    in property <float> lighting-level;
    in property <[color]> zone-colors;
    in-out property <int> omen-mode-index: 1;
    in-out property <int> omen-unleashed-pl1: 80;
    in-out property <int> omen-unleashed-tpp: 72;
    in-out property <int> omen-unleashed-gps: 87;
    in-out property <bool> omen-unleashed-ctgp: true;
    in-out property <bool> omen-unleashed-ppab: true;
    in-out property <int> language-index;
    in-out property <bool> autostart;
    in-out property <bool> start-in-tray;
    in-out property <int> close-index;
    in-out property <bool> hold-preset;
    in property <[string]> poll-rate-choices;
    in-out property <int> poll-rate-index: 1;
    in-out property <string> gpu-tgp-max-w;
    in property <string> gpu-tgp-max-error;
    in property <[string]> battery-choices;
    in-out property <int> battery-index;
    in property <bool> settings-ready;
    in-out property <bool> settings-dirty;
    in-out property <int> settings-tab;
    in property <[bool]> settings-tab-dirty;
    in property <[PluginRowData]> plugins;
    in property <[PluginNavData]> plugin-nav-items;
    in property <string> plugins-dir;
    in property <string> plugins-summary;
    in property <string> active-plugin-id;
    in property <string> active-plugin-title;
    // 0 = lighting-4zone, 1 = sensor-board, 2 = panel, 3 = hp-omen-suite
    in property <int> active-plugin-surface-kind;
    in property <string> plugin-confirm-text;
    in-out property <int> palette-index;
    in property <[PaletteChoice]> palette-choices;
    in property <[string]> color-look-choices;
    in-out property <int> background-look-index: 0;
    in-out property <int> nav-background-look-index: 0;
    in-out property <int> foreground-look-index: 0;
    in-out property <int> accent-look-index: 0;
    in property <color> background-preview;
    in property <color> nav-background-preview;
    in property <color> foreground-preview;
    in property <color> accent-preview;
    in property <color> background-secondary-preview;
    in property <color> nav-background-secondary-preview;
    in property <color> foreground-secondary-preview;
    in property <color> accent-secondary-preview;
    in-out property <string> color-background;
    in-out property <string> color-nav-background;
    in-out property <string> color-foreground;
    in-out property <string> color-accent;
    in-out property <string> color-background-secondary;
    in-out property <string> color-nav-background-secondary;
    in-out property <string> color-foreground-secondary;
    in-out property <string> color-accent-secondary;
    in property <string> appearance-error;
    in property <bool> hp-disabled;
    in property <bool> hp-available;
    in property <string> device-defaults-summary;
    in property <bool> hw-service-installed;
    in property <bool> hw-service-running;
    in property <bool> hw-service-outdated;
    in property <string> hw-service-pill-text;
    // StatusPill kind: 0 = good, 1 = muted, 2 = warning, 3 = error
    in property <int> hw-service-pill-kind: 1;
    in-out property <int> confirm-kind;
    in property <bool> notice-visible;
    in property <bool> notice-failed;
    in property <string> notice-title;
    in property <string> notice-text;
    callback navigate(int);
    callback window-action(int);
    callback refresh();
    callback select-preset(int);
    callback new-preset();
    callback name-edited(string);
    callback include-field(int, bool);
    callback edit-field(int, string);
    callback choice-field(int, int);
    callback edit-core(int, string);
    callback toggle-group(int);
    callback save-preset();
    callback apply-preset();
    callback delete-preset();
    callback reset-preset();
    callback cancel-preset();
    callback profile-fan-selected(int);
    callback battery-selected(int);
    callback fan-library-selected(int);
    callback fan-library-new();
    callback fan-library-name-edited(string);
    callback fan-library-reset();
    callback fan-library-save();
    callback fan-library-delete();
    callback fan-library-request();
    callback fan-library-refresh();
    callback startup-edited(bool);
    callback fan-change(int);
    callback graphics-change(int);
    callback open-curve(bool);
    callback curve-action(string);
    callback select-point(int);
    // kind (0 down, 1 drag, 2 up, 3 cancel, 5 double-click), x/y in 0..1,
    // plot width/height in px, Shift, Ctrl, Alt.
    callback chart-event(int, float, float, float, float, bool, bool, bool);
    // Wheel delta x/y in px, pointer x/y in 0..1, Shift, Ctrl.
    callback chart-wheel(float, float, float, float, bool, bool);
    callback chart-key(string, bool, bool, bool) -> bool;
    // A slider row moved to a whole-watt value.
    callback slider-field(int, float);
    // Pointer x/y in 0..1 without a pressed button (x < 0: left the chart),
    // plot width/height in px.
    callback chart-hover(float, float, float, float);
    callback chart-resized();
    callback lighting-power();
    callback select-lighting-group(int);
    callback keyboard-layout(bool);
    callback edit-lighting-color(string);
    callback edit-lighting-brightness(string);
    callback lighting-level-edited(float);
    callback pick-lighting-color();
    callback apply-lighting();
    callback reset-lighting();
    callback refresh-lighting();
    callback select-omen-mode(int);
    callback apply-omen-mode();
    callback reset-omen-unleashed();
    callback save-settings();
    callback discard-settings();
    callback settings-changed();
    callback toggle-plugin(string, bool);
    callback install-plugin();
    callback open-plugins-folder();
    callback reload-plugins();
    callback remove-plugin(string);
    callback select-plugin-page(string);
    callback palette-changed(int);
    callback look-changed(int, int);
    callback colors-changed();
    callback open-color-picker(int);
    callback reset-appearance();
    callback hp-service();
    callback hw-service-action(string);
    callback detect-defaults();
    callback show-about();
    callback confirm(bool);
    callback confirm-save();
    callback dismiss-notice();
    callback notice-details();
    callback close-notice-details();
}

component FieldRow inherits Rectangle {
    in-out property <FieldData> item;
    in-out property <bool> show-info;
    // The last row of a group has no divider under it.
    in property <bool> last;
    private property <length> base-height: max(Theme.row-height, include.preferred-height + 12px);
    height: root.base-height + (root.show-info ? info-text.preferred-height + 34px : 0px);

    // Every control keeps the control height; the same space above and below
    // centres label, info button, editor and unit on one line.
    HorizontalLayout {
        y: (root.base-height - max(Theme.control-height, include.preferred-height)) / 2;
        height: max(Theme.control-height, include.preferred-height);
        spacing: 8px;
        // The check box then starts where the group title text starts.
        padding-left: 8px;
        padding-right: 16px;
        include := CheckBox {
            text: root.item.label;
            checked <=> root.item.included;
            enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
            horizontal-stretch: 0;
            min-width: 0px;
            toggled => { Workbench.include-field(root.item.index, self.checked); }
        }

        info := InfoButton {
            label: Workbench.tr("ui.info") + ": " + root.item.label;
            enabled: Workbench.confirm-kind == 0;
            active: root.show-info;
            clicked => { root.show-info = !root.show-info; }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.item.kind == 0: LineEdit {
            accessible-label: root.item.label;
            text <=> root.item.value;
            unit: root.item.unit;
            width: Theme.number-width;
            horizontal-stretch: 0;
            enabled: (root.item.included && !Workbench.busy) && Workbench.confirm-kind == 0;
            edited(text) => { Workbench.edit-field(root.item.index, text); }
        }
        if root.item.kind == 1: ComboBox {
            accessible-label: root.item.label;
            model: root.item.choices;
            current-index <=> root.item.selected;
            width: Theme.field-width;
            horizontal-stretch: 0;
            enabled: (root.item.included && !Workbench.busy) && Workbench.confirm-kind == 0;
            selected(value) => { Workbench.choice-field(root.item.index, self.current-index); }
        }
        if root.item.kind == 2: Text {
            text: root.item.included ? Workbench.tr("common.on") : Workbench.tr("common.off");
            color: Theme.muted;
            width: Theme.field-width;
            vertical-alignment: center;
        }
        if root.item.kind == 3: ActionButton {
            text: Workbench.tr("ui.edit_curve");
            control-width: Theme.field-width;
            enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
            clicked => { Workbench.open-curve(true); }
        }
        // The slider and its value with unit share the common field width.
        if root.item.kind == 5: HorizontalLayout {
            width: Theme.field-width;
            horizontal-stretch: 0;
            spacing: 8px;
            BrightnessSlider {
                accessible-label: root.item.label;
                value: root.item.slider-value;
                minimum: root.item.slider-min;
                maximum: root.item.slider-max;
                enabled: (root.item.included && !Workbench.busy) && Workbench.confirm-kind == 0;
                edited(v) => { Workbench.slider-field(root.item.index, v); }
            }
            Text {
                text: root.item.unit == "" ? root.item.value : root.item.value + " " + root.item.unit;
                width: 60px;
                color: root.item.included ? Theme.ink : Theme.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        if root.item.kind == 4: Text {
            text: Workbench.tr("ui.per_core_below");
            color: Theme.muted;
            width: Theme.field-width;
            vertical-alignment: center;
        }
    }

    Rectangle {
        visible: root.show-info;
        x: 36px;
        y: root.base-height + 4px;
        width: parent.width - 52px;
        height: root.show-info ? info-text.preferred-height + 20px : 0px;
        background: Theme.surface-fill;
        border-radius: 6px;
        border-width: Theme.card-border-width;
        border-color: Theme.surface-border;

        info-text := Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            text: root.item.info;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    Rectangle {
        visible: !root.last;
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component PresetGroup inherits Rectangle {
    in property <GroupData> group;
    in property <int> index;
    height: layout.preferred-height;
    layout := VerticalLayout {
        spacing: 0px;
        if root.group.section-title != "": VerticalLayout {
            padding-top: root.index == 0 ? 4px : 14px;
            padding-bottom: 6px;
            spacing: 8px;
            if root.index > 0: Hairline { }
            HorizontalLayout {
                spacing: 8px;
                padding-left: 4px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 15px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
                SectionTitle {
                    text: root.group.section-title;
                }
            }
        }
        SectionHeader {
            text: root.group.title;
            expanded: root.group.expanded;
            clicked => { Workbench.toggle-group(root.index); }
        }

        Rectangle {
            height: root.group.expanded ? row-layout.preferred-height : 0px;
            visible: root.group.expanded;
            row-layout := VerticalLayout {
                padding-bottom: 4px;
                for row[row-index] in root.group.rows: FieldRow {
                    item <=> row;
                    last: row-index == root.group.rows.length - 1 && !root.group.is-per-core;
                }
                if root.group.is-per-core: GridLayout {
                    spacing: 8px;
                    for item[index] in Workbench.cores: HorizontalLayout {
                        row: floor(index / 4);
                        col: mod(index, 4);
                        Text {
                            text: item.label;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            accessible-label: item.label;
                            text: item.value;
                            min-width: 40px;
                            max-width: 60px;
                            preferred-width: 52px;
                            enabled: (root.group.rows[0].included && !Workbench.busy) && Workbench.confirm-kind == 0;
                            edited(value) => { Workbench.edit-core(index, value); }
                        }
                    }
                }
            }
        }
    }
}

component CurveCanvas inherits Rectangle {
    forward-focus: chart-focus;
    background: Theme.surface-fill;
    border-radius: 8px;
    border-width: Theme.card-border-width;
    border-color: Theme.surface-border;
    clip: true;
    min-height: 190px;
    // Margins around the plot: Y labels left, X labels below, captions above.
    private property <length> plot-left: 52px;
    private property <length> plot-top: 26px;
    private property <length> plot-right: 18px;
    private property <length> plot-bottom: 26px;

    Text {
        x: 4px;
        y: 4px;
        width: root.plot-left - 10px;
        height: 16px;
        text: Workbench.curve-y-label;
        color: Theme.quiet;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: root.plot-left;
        y: 4px;
        width: max(0px, root.width - root.plot-left - root.plot-right);
        height: 16px;
        text: Workbench.curve-delta;
        color: Theme.ink;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    for tick in Workbench.y-ticks: Text {
        x: 4px;
        y: root.plot-top + (1 - tick.position) * plot.height - self.height / 2;
        width: root.plot-left - 10px;
        height: 14px;
        text: tick.label;
        color: Theme.muted;
        font-family: "Consolas";
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: 4px;
        y: root.plot-top + plot.height + 6px;
        width: root.plot-left - 22px;
        height: 14px;
        text: Workbench.curve-x-label;
        color: Theme.quiet;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Centred under their grid line; labels on the plot edges align with it.
    for tick in Workbench.x-ticks: Text {
        property <bool> first: tick.position < 0.001;
        property <bool> last: tick.position > 0.999;
        x: self.first ? root.plot-left : self.last ? root.plot-left + plot.width - self.width : clamp(root.plot-left + tick.position * plot.width - self.width / 2, root.plot-left, max(root.plot-left, root.width - self.width));
        y: root.plot-top + plot.height + 6px;
        width: 48px;
        height: 14px;
        text: tick.label;
        color: Theme.muted;
        font-family: "Consolas";
        font-size: 11px;
        horizontal-alignment: self.first ? TextHorizontalAlignment.left : self.last ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;
        vertical-alignment: center;
    }

    plot := Rectangle {
        x: root.plot-left;
        y: root.plot-top;
        width: max(1px, root.width - root.plot-left - root.plot-right);
        height: max(1px, root.height - root.plot-top - root.plot-bottom);
        clip: true;
        init => {
            Workbench.plot-width = self.width / 1px;
            Workbench.plot-height = self.height / 1px;
        }
        changed width => {
            Workbench.plot-width = self.width / 1px;
            Workbench.chart-resized();
        }
        changed height => {
            Workbench.plot-height = self.height / 1px;
            Workbench.chart-resized();
        }

        // Grid lines use the same mapping as points and path, snapped to one
        // physical pixel so every line has the same weight.
        for tick in Workbench.y-ticks: Rectangle {
            y: floor((1 - tick.position) * parent.height / 1phx) * 1phx;
            height: 1phx;
            background: Theme.line;
        }
        for tick in Workbench.x-ticks: Rectangle {
            x: floor(tick.position * parent.width / 1phx) * 1phx;
            width: 1phx;
            background: Theme.line;
        }
        selection-band := Rectangle {
            visible: Workbench.has-selection && Workbench.selection-high >= 0 && Workbench.selection-low <= 1;
            x: clamp(Workbench.selection-low,0,1) * parent.width;
            width: max(2px,(clamp(Workbench.selection-high,0,1) - clamp(Workbench.selection-low,0,1)) * parent.width);
            background: Theme.accent.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.55);
        }

        reference-line := Path {
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: Workbench.reference-path;
            stroke: Theme.muted;
            stroke-width: 1px;
            fill: transparent;
        }

        curve-line := Path {
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: Workbench.curve-path;
            stroke: Theme.accent;
            stroke-width: 2px;
            fill: transparent;
        }

        Rectangle {
            visible: Workbench.nodes.length > 0 && Workbench.point-index >= 0 && Workbench.point-index < Workbench.nodes.length;
            x: floor(Workbench.nodes[Workbench.point-index].x * parent.width / 1phx) * 1phx;
            width: 1phx;
            background: Theme.accent.with-alpha(0.25);
        }

        Rectangle {
            visible: Workbench.nodes.length > 0 && Workbench.point-index >= 0 && Workbench.point-index < Workbench.nodes.length;
            y: floor((1 - Workbench.nodes[Workbench.point-index].y) * parent.height / 1phx) * 1phx;
            height: 1phx;
            background: Theme.accent.with-alpha(0.25);
        }

        for point[index] in Workbench.nodes: draft-node := Rectangle {
            x: point.x * parent.width - self.width / 2;
            y: (1 - point.y) * parent.height - self.height / 2;
            width: point.selected ? 8px : 5px;
            height: self.width;
            background: point.selected ? Theme.accent : Theme.ink;
        }

        hover-marker := Rectangle {
            visible: Workbench.curve-readout != "" && Workbench.readout-hover;
            x: Workbench.readout-x * parent.width - self.width / 2;
            y: (1 - Workbench.readout-y) * parent.height - self.height / 2;
            width: 13px;
            height: 13px;
            border-radius: 3px;
            border-width: 2px;
            border-color: Theme.accent;
        }

        readout := Rectangle {
            visible: Workbench.curve-readout != "";
            property <length> anchor-x: Workbench.readout-x * parent.width;
            property <length> anchor-y: (1 - Workbench.readout-y) * parent.height;
            width: readout-text.preferred-width + 16px;
            height: readout-text.preferred-height + 10px;
            // Beside the point, flipped away from the plot edges.
            x: clamp(self.anchor-x + 12px + self.width > parent.width ? self.anchor-x - 12px - self.width : self.anchor-x + 12px, 0px, max(0px, parent.width - self.width));
            y: clamp(self.anchor-y - 12px - self.height < 0px ? self.anchor-y + 12px : self.anchor-y - 12px - self.height, 0px, max(0px, parent.height - self.height));
            background: Theme.popup-fill;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.accent-border;
            readout-text := Text {
                x: 8px;
                y: 5px;
                text: Workbench.curve-readout;
                color: Theme.ink;
                font-family: "Consolas";
                font-size: 11px;
            }
        }

        canvas-input := TouchArea {
            mouse-cursor: crosshair;
            clicked => { chart-focus.focus(); }
            moved => {
                if (self.pressed) {
                    Workbench.chart-event(1, self.mouse-x / self.width, self.mouse-y / self.height,
                    self.width / 1px, self.height / 1px, false, false, false);
                }
            }
            double-clicked => {
                Workbench.chart-event(5, self.mouse-x / self.width, self.mouse-y / self.height,
                self.width / 1px, self.height / 1px, false, false, false);
            }
            changed has-hover => {
                if !self.has-hover {
                    Workbench.chart-hover(-1, -1, self.width / 1px, self.height / 1px);
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.move {
                    if !self.pressed {
                        Workbench.chart-hover(self.mouse-x / self.width, self.mouse-y / self.height,
                        self.width / 1px, self.height / 1px);
                    }
                } else if e.kind == PointerEventKind.cancel {
                    Workbench.chart-event(3, 0, 0, self.width / 1px, self.height / 1px, false, false, false);
                } else if (e.button == PointerEventButton.left) {
                    chart-focus.focus();
                    Workbench.chart-event(e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 2 : 3,
                    self.mouse-x / self.width, self.mouse-y / self.height, self.width / 1px, self.height / 1px,
                    e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                }
            }
            scroll-event(e) => {
                Workbench.chart-wheel(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x / self.width,
                self.mouse-y / self.height, e.modifiers.shift, e.modifiers.control);
                return accept;
            }
        }

        chart-focus := FocusScope {
            x: 0px;
            width: 0px;
            key-pressed(e) => {
                return Workbench.chart-key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt) ? accept : reject;
            }
        }
    }
}

component ConfirmPrompt inherits FocusScope {
    in property <int> kind;
    callback accepted(bool);
    callback save-requested();
    private property <bool> confirm-focused;
    forward-focus: cancel-button;
    init => { cancel-button.focus(); }
    capture-key-pressed(e) => {
        if e.text == Key.Escape { root.accepted(false); return accept; }
        if e.text == Key.Tab || e.text == Key.Backtab {
            let count = root.kind == 1 ? 3 : 2;
            let at = cancel-button.keyboard-focus ? 0 : confirm-button.keyboard-focus ? 1 : 2;
            let next = mod(at + (e.text == Key.Backtab || e.modifiers.shift ? count - 1 : 1),count);
            if next == 0 { cancel-button.focus(); } else if next == 1 { confirm-button.focus(); } else { save-button.focus(); }
            return accept;
        }
        return reject;
    }
    Rectangle {
        background: Theme.scrim;
        TouchArea {
            scroll-event(e) => { return accept; }
        }
    }

    Rectangle {
        width: min(480px, parent.width - 48px);
        height: confirm-layout.preferred-height;
        background: Theme.popup-fill;
        border-width: Theme.card-border-width;
        border-color: Theme.popup-border;
        border-radius: 10px;
        clip: true;
        confirm-layout := VerticalLayout {
            padding: 20px;
            spacing: 16px;
            Text {
                text: root.kind == 7 || root.kind == 8 || root.kind == 9
                    ? Workbench.plugin-confirm-text
                    : Workbench.tr(root.kind == 2 ? "ui.confirm_delete" : root.kind == 3 ? "ui.confirm_exit" : "notice.unsaved_preset");
                color: Theme.ink;
                wrap: word-wrap;
            }

            if root.kind == 1 && Workbench.preset-startup: Text {
                text: Workbench.tr("preset.startup_on_save");
                color: Theme.warning;
                wrap: word-wrap;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    horizontal-stretch: 1;
                }

                cancel-button := ActionButton {
                    text: Workbench.tr("ui.cancel");
                    clicked => { root.accepted(false); }
                }

                Rectangle {
                    width: 8px;
                }

                confirm-button := ActionButton {
                    text: Workbench.tr(root.kind == 2 ? "preset.delete" : root.kind == 7 ? "plugins.replace" : root.kind == 8 ? "plugins.remove" : root.kind == 9 ? "omen.confirm_apply" : "notice.discard");
                    primary: root.kind != 1;
                    clicked => { root.accepted(true); }
                }

                Rectangle {
                    width: root.kind == 1 ? 8px : 0px;
                }

                save-button := ActionButton {
                    visible: root.kind == 1;
                    enabled: root.kind == 1;
                    fixed-width: root.kind != 1;
                    control-width: root.kind == 1 ? Theme.action-width : 0px;
                    text: Workbench.tr("preset.save");
                    primary: true;
                    clicked => { root.save-requested(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    public function focus-curve() { chart.focus(); }
    // Enter in the chart: edit the selected point's value numerically.
    public function edit-curve-value() { point-y.focus(); }
    callback color-picker-closed(int);
    color-picker-closed(target) => {
        if target == 3 { lighting-color.focus(); }
        else { settings-button.focus(); }
    }
    title: "GLPH";
    no-frame: true;
    resize-border-width: Workbench.window-maximized ? 0px : 6px;
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 500px;
    max-width: 10000px;
    max-height: 10000px;
    background: Theme.nav-fill;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    private property <bool> dark-appearance: Theme.dark;
    changed dark-appearance => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    private property <bool> device-details;
    private property <bool> battery-details;
    private property <bool> fan-link-details;

    if Theme.has-nav-texture: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: Theme.nav-texture;
        image-fit: fill;
        accessible-role: none;
    }

    titlebar := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 38px;
        background: transparent;
        titlebar-move := WindowMoveArea {
            x: 6px;
            y: 0px;
            width: parent.width - 144px;
            height: parent.height;
            Text {
                x: 16px;
                width: 170px;
                text: "GLPH";
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 0.9px;
                color: Theme.nav-ink;
                vertical-alignment: center;
            }

            Text {
                x: 198px;
                width: max(0px, parent.width - 214px);
                text: Workbench.busy ? Workbench.tr("control.working")
                    : Workbench.page < 2 ? Workbench.tr("ui.overview")
                    : Workbench.page == 2 ? Workbench.tr("ui.cooling")
                    : Workbench.page == 3 ? (Workbench.active-plugin-title != "" ? Workbench.active-plugin-title : Workbench.tr("ui.lighting"))
                    : Workbench.tr("settings.title");
                font-size: 12px;
                font-weight: 500;
                color: Theme.nav-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                double-clicked => { Workbench.window-action(1); }
                pointer-event(e) => { if e.kind == PointerEventKind.up && e.button == PointerEventButton.right { Workbench.window-action(3); } }
            }
        }

        window-minimize := CaptionButton {
            x: parent.width - 138px;
            kind: 0;
            text: Workbench.tr("window.minimize");
            clicked => { Workbench.window-action(0); }
        }

        window-maximize := CaptionButton {
            x: parent.width - 92px;
            kind: 1;
            maximized: Workbench.window-maximized;
            text: Workbench.tr(Workbench.window-maximized ? "window.restore" : "window.maximize");
            clicked => { Workbench.window-action(1); }
        }

        window-close := CaptionButton {
            x: parent.width - 46px;
            kind: 2;
            text: Workbench.tr("settings.close");
            clicked => { Workbench.window-action(2); }
        }
    }

    sidebar := Rectangle {
        x: 0px;
        y: 38px;
        width: 200px;
        height: max(0px, parent.height - 38px);
        background: transparent;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 4px;
            navigation-overview := NavigationItem {
                kind: 0;
                text: Workbench.tr("ui.overview");
                selected: Workbench.page < 2;
                enabled: Workbench.confirm-kind == 0;
                clicked => { Workbench.navigate(0); }
            }

            navigation-cooling := NavigationItem {
                kind: 1;
                text: Workbench.tr("ui.cooling");
                selected: Workbench.page == 2;
                enabled: Workbench.confirm-kind == 0;
                clicked => { Workbench.navigate(2); }
            }

            if Workbench.plugin-nav-items.length > 0: Rectangle {
                height: 9px;
                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: max(0px, parent.width - 8px);
                    height: 1px;
                    background: Theme.nav-line.with-alpha(0.65);
                }
            }

            if Workbench.plugin-nav-items.length > 0: ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: plugin-nav-list.preferred-height;
                plugin-nav-list := VerticalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 4px;
                    for item in Workbench.plugin-nav-items: NavigationItem {
                        kind: item.icon-kind;
                        text: item.label;
                        selected: Workbench.page == 3 && Workbench.active-plugin-id == item.id;
                        enabled: Workbench.confirm-kind == 0;
                        clicked => { Workbench.select-plugin-page(item.id); }
                    }
                }
            }

            if Workbench.plugin-nav-items.length == 0: Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: 9px;
                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: max(0px, parent.width - 8px);
                    height: 1px;
                    background: Theme.nav-line.with-alpha(0.65);
                }
            }

            settings-button := NavigationItem {
                kind: 3;
                text: Workbench.tr("settings.title");
                selected: Workbench.page == 4;
                enabled: Workbench.confirm-kind == 0;
                clicked => { Workbench.navigate(4); }
            }
        }
    }

    workspace := Rectangle {
        x: 200px;
        y: 38px;
        width: max(0px, parent.width - 208px);
        height: max(0px, parent.height - 46px);
        border-radius: 12px;
        border-width: Theme.card-border-width;
        border-color: Theme.canvas-frame-border;
        background: Theme.canvas-fill;
        clip: true;

        if Theme.has-canvas-texture: Image {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            source: Theme.canvas-texture;
            image-fit: fill;
            accessible-role: none;
        }

        VerticalLayout {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            spacing: 0px;
            if Workbench.test-mode: Text {
                text: Workbench.tr("ui.test_mode");
                color: Theme.warning;
                height: 22px;
                horizontal-alignment: center;
            }
            Rectangle {
                vertical-stretch: 1;
                overview := Rectangle {
                    visible: Workbench.page < 2 && !Workbench.curve-open;
                    VerticalLayout {
                        width: min(Theme.workspace-width,parent.width);
                        x: (parent.width - self.width) / 2;
                        padding: 20px;
                        spacing: 12px;
                        preset-list := ScrollView {
                            content-width: self.visible-width - 12px;
                            VerticalLayout {
                                spacing: 12px;
                                TelemetryPanel { }

                                HorizontalLayout {
                                    spacing: 8px;
                                    device-details-toggle := ActionButton {
                                        text: Workbench.tr("ui.device_modes");
                                        clicked => { root.device-details = !root.device-details; }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    refresh := ActionButton {
                                        text: Workbench.tr("ui.refresh");
                                        enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.refresh(); }
                                    }
                                }

                                if root.device-details: SettingsCard {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        if Workbench.gpu-tgp != "" || Workbench.chassis-temp != "": HorizontalLayout {
                                            spacing: 16px;
                                            if Workbench.gpu-tgp != "": Text {
                                                text: Workbench.gpu-tgp;
                                                color: Theme.muted;
                                                font-family: "Consolas";
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                            }
                                            if Workbench.chassis-temp != "": Text {
                                                text: Workbench.chassis-temp;
                                                color: Theme.muted;
                                                font-family: "Consolas";
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        Text {
                                            text: Workbench.cpu-source;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }

                                        Text {
                                            visible: Workbench.sensor-details != "";
                                            text: Workbench.sensor-details;
                                            color: Theme.warning;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: Workbench.last-apply;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }

                                        Hairline { }

                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: Workbench.tr("ui.graphics");
                                                color: Theme.ink;
                                                vertical-alignment: center;
                                            }

                                            ComboBox {
                                                accessible-label: Workbench.tr("ui.graphics");
                                                model: [Workbench.tr("mux.hybrid"), Workbench.tr("mux.discrete")];
                                                current-index <=> Workbench.graphics-index;
                                                enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                                selected(value) => { Workbench.graphics-change(self.current-index); }
                                            }

                                            Text {
                                                text: Workbench.graphics-status;
                                                color: Theme.muted;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }
                                        }

                                        ActionButton {
                                            visible: Workbench.recovery-pending;
                                            text: Workbench.tr("preset.restore_button");
                                            enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                            clicked => { Workbench.apply-preset(); }
                                        }

                                        Text {
                                            text: Workbench.identity + "  ·  " + Workbench.power-source + "  ·  " + Workbench.tr(Workbench.admin ? "ui.admin" : "ui.user");
                                            color: Theme.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Hairline { }

                                SectionTitle {
                                    text: Workbench.tr("ui.presets");
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-right: 16px;
                                    Text {
                                        text: Workbench.tr("preset.selector_label");
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    preset-selector := ComboBox {
                                        width: Theme.field-width;
                                        accessible-label: Workbench.tr("preset.selector_label");
                                        model: Workbench.profiles;
                                        current-index <=> Workbench.profile-index;
                                        enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        selected(value) => { Workbench.select-preset(self.current-index); }
                                    }

                                    new-preset := ActionButton {
                                        text: "+";
                                        control-width: Theme.info-width;
                                        accessible-label: Workbench.tr("preset.new");
                                        enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.new-preset(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-right: 16px;
                                    Text {
                                        text: Workbench.tr("ui.preset_name");
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    preset-name := LineEdit {
                                        width: Theme.field-width;
                                        accessible-label: Workbench.tr("ui.preset_name");
                                        text <=> Workbench.preset-name;
                                        placeholder-text: Workbench.tr("ui.preset_name");
                                        enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        edited(text) => { Workbench.name-edited(text); }
                                    }

                                    Rectangle {
                                        width: Theme.info-width;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-right: 16px;
                                    Text {
                                        text: Workbench.tr("battery.behaviour");
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    battery := ComboBox {
                                        accessible-label: Workbench.tr("battery.behaviour");
                                        width: Theme.field-width;
                                        model: Workbench.battery-choices;
                                        current-index <=> Workbench.battery-index;
                                        enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        selected(value) => { Workbench.battery-selected(self.current-index); }
                                    }

                                    battery-info := InfoButton {
                                        label: Workbench.tr("battery.behaviour_info");
                                        enabled: Workbench.confirm-kind == 0;
                                        active: root.battery-details;
                                        clicked => { root.battery-details = !root.battery-details; }
                                    }
                                }

                                if root.battery-details: Text {
                                    text: Workbench.tr("info.battery_behaviour");
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-right: 16px;
                                    Text {
                                        text: Workbench.tr("fan_profile.link");
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    profile-fan := ComboBox {
                                        accessible-label: Workbench.tr("fan_profile.link");
                                        width: Theme.field-width;
                                        model: Workbench.profile-fan-choices;
                                        current-index <=> Workbench.profile-fan-index;
                                        enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        selected(value) => { Workbench.profile-fan-selected(self.current-index); }
                                    }

                                    fan-link-info := InfoButton {
                                        label: Workbench.tr("ui.info") + ": " + Workbench.tr("fan_profile.link");
                                        enabled: Workbench.confirm-kind == 0;
                                        active: root.fan-link-details;
                                        clicked => { root.fan-link-details = !root.fan-link-details; }
                                    }
                                }

                                if root.fan-link-details: Text {
                                    text: Workbench.tr("fan_profile.manual_note");
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for group[index] in Workbench.groups: PresetGroup {
                                    group: group;
                                    index: index;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-right: 12px;
                            startup := CheckBox {
                                text: Workbench.tr("preset.startup_label");
                                checked <=> Workbench.preset-startup;
                                enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                toggled => { Workbench.startup-edited(self.checked); }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: Workbench.dirty ? Workbench.tr("preset.unsaved") : "";
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }

                        if Workbench.preset-startup && Workbench.dirty: Text {
                            text: Workbench.tr("preset.startup_on_save");
                            color: Theme.warning;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        preset-actions := Rectangle {
                            height: self.width < 720px ? 80px : Theme.control-height;
                            vertical-stretch: 0;
                            HorizontalLayout {
                                y: 0px;
                                height: Theme.control-height;
                                spacing: 8px;
                                ActionButton {
                                    text: Workbench.tr("ui.reset_draft");
                                    enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.reset-preset(); }
                                }

                                cancel-preset := ActionButton {
                                    control-width: 160px;
                                    text: Workbench.tr("preset.cancel_edit");
                                    enabled: Workbench.preset-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.cancel-preset(); }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                width: 400px;
                                x: parent.width - self.width - 12px;
                                y: parent.width < 720px ? 44px : 0px;
                                height: Theme.control-height;
                                spacing: 8px;
                                delete-preset := ActionButton {
                                    text: Workbench.tr("preset.delete");
                                    enabled: (Workbench.preset-saved && !Workbench.busy && !Workbench.recovery-pending) && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.delete-preset(); }
                                }

                                save-preset := ActionButton {
                                    text: Workbench.tr("preset.save");
                                    enabled: (Workbench.preset-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.save-preset(); }
                                }

                                apply-preset := ActionButton {
                                    text: Workbench.tr("preset.apply_button");
                                    primary: true;
                                    enabled: Workbench.preset-saved && Workbench.preset-applicable && !Workbench.dirty && !Workbench.operation-busy && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.apply-preset(); }
                                }
                            }
                        }
                    }
                }

                cooling := ScrollView {
                    content-width: self.visible-width - 12px;
                    content-height: cooling-content.preferred-height;
                    visible: Workbench.page == 2 && !Workbench.curve-open;
                    cooling-content := VerticalLayout {
                        width: min(880px, parent.width);
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        height: self.preferred-height;
                        padding: 20px;
                        spacing: 14px;
                        SectionTitle {
                            text: Workbench.tr("ui.cooling");
                        }

                        SettingsCard {
                            VerticalLayout {
                                spacing: 0px;
                                SettingRow {
                                    label: Workbench.tr("ui.fan_request");
                                    description: Workbench.cooling-status;
                                    last: true;
                                    fan-selector := ComboBox {
                                        width: Theme.field-width;
                                        model: [
                                            Workbench.tr("ui.fan_bios"),
                                            Workbench.tr("ui.fan_curve"),
                                            Workbench.tr("ui.fan_max")
                                        ];
                                        current-index <=> Workbench.fan-index;
                                        enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                        selected(value) => { Workbench.fan-change(self.current-index); }
                                    }
                                }
                            }
                        }

                        SectionTitle {
                            text: Workbench.tr("fan_profile.library_title");
                        }

                        SettingsCard {
                            VerticalLayout {
                                spacing: 0px;

                                SettingRow {
                                    label: Workbench.tr("fan_profile.preset");
                                    fan-library-selector := ComboBox {
                                        width: Theme.field-width;
                                        accessible-label: Workbench.tr("fan_profile.preset");
                                        model: Workbench.fan-library-names;
                                        current-index <=> Workbench.fan-library-index;
                                        enabled: Workbench.fan-library-ready && !Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        selected(value) => { Workbench.fan-library-selected(self.current-index); }
                                    }

                                    ActionButton {
                                        text: "+";
                                        accessible-label: Workbench.tr("fan_profile.new");
                                        enabled: Workbench.fan-library-ready && !Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-new(); }
                                    }
                                }

                                SettingRow {
                                    label: Workbench.tr("fan_profile.name");
                                    description: Workbench.tr("fan_profile.library_note");
                                    fan-library-name := LineEdit {
                                        width: Theme.field-width;
                                        accessible-label: Workbench.tr("fan_profile.name");
                                        text <=> Workbench.fan-library-name;
                                        enabled: Workbench.fan-library-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        edited(value) => { Workbench.fan-library-name-edited(value); }
                                    }

                                    Rectangle {
                                        width: Theme.control-height;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 12px;
                                    padding-bottom: 12px;
                                    spacing: 8px;
                                    edit-fan := ActionButton {
                                        text: Workbench.tr("ui.edit_curve");
                                        enabled: Workbench.fan-library-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.open-curve(false); }
                                    }

                                    fan-library-reset := ActionButton {
                                        text: Workbench.tr("preset.cancel_edit");
                                        control-width: 160px;
                                        enabled: Workbench.fan-library-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-reset(); }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    ActionButton {
                                        text: Workbench.tr("ui.refresh");
                                        enabled: !Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-refresh(); }
                                    }
                                }

                                Hairline { }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 12px;
                                    padding-bottom: 14px;
                                    spacing: 8px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    fan-library-delete := ActionButton {
                                        text: Workbench.tr("preset.delete");
                                        enabled: Workbench.fan-library-saved && !Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-delete(); }
                                    }

                                    fan-library-save := ActionButton {
                                        text: Workbench.tr("preset.save");
                                        enabled: Workbench.fan-library-ready && Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-save(); }
                                    }

                                    fan-library-request := ActionButton {
                                        text: Workbench.tr("preset.apply_button");
                                        primary: true;
                                        enabled: Workbench.fan-library-saved && !Workbench.fan-library-dirty && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.fan-library-request(); }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }

                lighting := Rectangle {
                    visible: Workbench.page == 3 && !Workbench.curve-open && (Workbench.active-plugin-surface-kind == 0 || Workbench.active-plugin-surface-kind == 3);
                    lighting-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        content-width: self.visible-width - 12px;
                        content-height: lighting-outer.preferred-height;
                        lighting-outer := VerticalLayout {
                            width: min(Theme.workspace-width, parent.width);
                            x: (parent.width - self.width) / 2;
                            height: self.preferred-height;
                            padding: 20px;
                            spacing: 16px;

                            // --- Top section: 4-Zone Keyboard Lighting ---
                            HorizontalLayout {
                                spacing: 8px;
                                SectionTitle {
                                    text: Workbench.active-plugin-surface-kind == 3 ? Workbench.tr("ui.lighting") : (Workbench.active-plugin-title != "" ? Workbench.active-plugin-title : Workbench.tr("ui.lighting"));
                                    horizontal-stretch: 1;
                                }

                                keyboard-layout := ComboBox {
                                    accessible-label: Workbench.tr("lighting.layout");
                                    width: Theme.field-width;
                                    model: ["Deutsch · QWERTZ", "English · QWERTY"];
                                    current-index: Workbench.keyboard-german ? 0 : 1;
                                    enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                    selected(value) => { Workbench.keyboard-layout(self.current-index == 0); }
                                }

                                lighting-power := ActionButton {
                                    text: Workbench.lighting-on ? Workbench.tr("common.on") : Workbench.tr("common.off");
                                    enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.lighting-power(); }
                                }

                                Text {
                                    text: Workbench.lighting-dirty ? Workbench.tr("lighting.preview") : "";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            lighting-content := VerticalLayout {
                                spacing: 12px;
                                keyboard-preview := KeyboardPreview {
                                    keys: Workbench.keyboard-keys;
                                    colors: Workbench.zone-colors;
                                    selected: Workbench.lighting-group;
                                    enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                    selected-group(index) => { Workbench.select-lighting-group(index); }
                                }

                                lighting-groups := SegmentedTabs {
                                    enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                    labels: [
                                        Workbench.tr("lighting.wasd"),
                                        Workbench.tr("lighting.zone_left"),
                                        Workbench.tr("lighting.zone_middle"),
                                        Workbench.tr("lighting.numpad_right")
                                    ];
                                    selected: Workbench.lighting-group;
                                    changed(index) => { Workbench.select-lighting-group(index); }
                                }

                                HorizontalLayout {
                                    Text {
                                        text: Workbench.tr("lighting.color");
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    lighting-color := ColorField {
                                        text: Workbench.tr("lighting.color");
                                        value: Workbench.lighting-color;
                                        mixed: Workbench.lighting-color == "";
                                        swatch-color: Workbench.zone-colors[3 - Workbench.lighting-group];
                                        enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.pick-lighting-color(); }
                                    }
                                }

                                HorizontalLayout {
                                    Text {
                                        text: Workbench.tr("lighting.brightness");
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    lighting-value := Rectangle {
                                        width: Theme.field-width;
                                        height: Theme.control-height;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: lighting-brightness.has-focus || lighting-slider.has-focus ? Theme.accent : Theme.control-border;
                                        background: Theme.control-fill;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            lighting-slider := BrightnessSlider {
                                                accessible-label: Workbench.tr("lighting.brightness");
                                                value: Workbench.lighting-level;
                                                enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                edited(value) => { Workbench.lighting-level-edited(value); }
                                            }

                                            lighting-brightness := LineEdit {
                                                width: 60px;
                                                background: transparent;
                                                border-width: 0px;
                                                accessible-label: Workbench.tr("lighting.brightness");
                                                text <=> Workbench.lighting-brightness;
                                                placeholder-text: Workbench.tr("lighting.mixed");
                                                enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                edited(value) => { Workbench.edit-lighting-brightness(value); }
                                            }

                                            Text {
                                                text: "%";
                                                color: Theme.muted;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if Workbench.lighting-error != "": Text {
                                    text: Workbench.lighting-error;
                                    color: Theme.error;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    lighting-reset := ActionButton {
                                        text: Workbench.tr("ui.reset_draft");
                                        enabled: Workbench.lighting-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.reset-lighting(); }
                                    }

                                    lighting-refresh := ActionButton {
                                        text: Workbench.tr("ui.refresh");
                                        enabled: !Workbench.busy && !Workbench.lighting-dirty && Workbench.lighting-error == "" && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.refresh-lighting(); }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    lighting-apply := ActionButton {
                                        text: Workbench.tr("preset.apply_button");
                                        accessible-description: Workbench.lighting-confirmed;
                                        primary: true;
                                        enabled: Workbench.lighting-ready && Workbench.lighting-dirty && Workbench.lighting-error == "" && !Workbench.busy && Workbench.confirm-kind == 0;
                                        clicked => { Workbench.apply-lighting(); }
                                    }
                                }
                            }

                            // --- Bottom section: Original HP OMEN Performance Modes (only for hp-omen-suite) ---
                            if Workbench.active-plugin-surface-kind == 3: VerticalLayout {
                                spacing: 12px;

                                Hairline { }

                                VerticalLayout {
                                    spacing: 2px;
                                    SectionTitle {
                                        text: Workbench.tr("omen.modes_title");
                                    }
                                    Text {
                                        text: Workbench.tr("omen.modes_subtitle");
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                SettingsCard {
                                    VerticalLayout {
                                        spacing: 0px;

                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 12px;

                                            omen-mode-tabs := SegmentedTabs {
                                                enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                labels: [
                                                    Workbench.tr("mode.quiet"),
                                                    Workbench.tr("mode.balanced"),
                                                    Workbench.tr("mode.performance"),
                                                    Workbench.tr("mode.unleashed")
                                                ];
                                                selected: Workbench.omen-mode-index;
                                                changed(index) => { Workbench.select-omen-mode(index); }
                                            }

                                            CalloutBanner {
                                                severity: Workbench.omen-mode-index == 3 ? 1 : 0;
                                                text: Workbench.omen-mode-index == 0 ? Workbench.tr("omen.mode_desc_quiet")
                                                    : Workbench.omen-mode-index == 1 ? Workbench.tr("omen.mode_desc_balanced")
                                                    : Workbench.omen-mode-index == 2 ? Workbench.tr("omen.mode_desc_performance")
                                                    : Workbench.tr("omen.mode_desc_unleashed");
                                            }
                                        }

                                        if Workbench.omen-mode-index == 3: VerticalLayout {
                                            spacing: 0px;

                                            Hairline { }

                                            SettingRow {
                                                label: Workbench.tr("omen.unleashed_pl1");
                                                description: Workbench.tr("omen.unleashed_pl1_desc");
                                                HorizontalLayout {
                                                    width: 240px;
                                                    spacing: 10px;
                                                    BrightnessSlider {
                                                        accessible-label: Workbench.tr("omen.unleashed_pl1");
                                                        minimum: 45;
                                                        maximum: 95;
                                                        value: Workbench.omen-unleashed-pl1;
                                                        enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                        edited(v) => { Workbench.omen-unleashed-pl1 = round(v); }
                                                    }
                                                    Text {
                                                        width: 52px;
                                                        text: Workbench.omen-unleashed-pl1 + " W";
                                                        color: Theme.ink;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("omen.unleashed_tpp");
                                                description: Workbench.tr("omen.unleashed_tpp_desc");
                                                HorizontalLayout {
                                                    width: 240px;
                                                    spacing: 10px;
                                                    BrightnessSlider {
                                                        accessible-label: Workbench.tr("omen.unleashed_tpp");
                                                        minimum: 30;
                                                        maximum: 72;
                                                        value: Workbench.omen-unleashed-tpp;
                                                        enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                        edited(v) => { Workbench.omen-unleashed-tpp = round(v); }
                                                    }
                                                    Text {
                                                        width: 52px;
                                                        text: Workbench.omen-unleashed-tpp + " W";
                                                        color: Theme.ink;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("omen.unleashed_gps");
                                                description: Workbench.tr("omen.unleashed_gps_desc");
                                                HorizontalLayout {
                                                    width: 240px;
                                                    spacing: 10px;
                                                    BrightnessSlider {
                                                        accessible-label: Workbench.tr("omen.unleashed_gps");
                                                        minimum: 65;
                                                        maximum: 87;
                                                        value: Workbench.omen-unleashed-gps;
                                                        enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                        edited(v) => { Workbench.omen-unleashed-gps = round(v); }
                                                    }
                                                    Text {
                                                        width: 52px;
                                                        text: Workbench.omen-unleashed-gps + " °C";
                                                        color: Theme.ink;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("omen.unleashed_ctgp");
                                                description: Workbench.tr("omen.unleashed_ctgp_desc");
                                                ToggleSwitch {
                                                    accessible-label: Workbench.tr("omen.unleashed_ctgp");
                                                    checked: Workbench.omen-unleashed-ctgp;
                                                    enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                    toggled(v) => { Workbench.omen-unleashed-ctgp = v; }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("omen.unleashed_ppab");
                                                description: Workbench.tr("omen.unleashed_ppab_desc");
                                                last: true;
                                                ToggleSwitch {
                                                    accessible-label: Workbench.tr("omen.unleashed_ppab");
                                                    checked: Workbench.omen-unleashed-ppab;
                                                    enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                    toggled(v) => { Workbench.omen-unleashed-ppab = v; }
                                                }
                                            }
                                        }

                                        Hairline { }

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-top: 12px;
                                            padding-bottom: 14px;
                                            spacing: 8px;

                                            if Workbench.omen-mode-index == 3: ActionButton {
                                                text: Workbench.tr("omen.unleashed_reset");
                                                enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                clicked => { Workbench.reset-omen-unleashed(); }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            omen-mode-apply := ActionButton {
                                                text: Workbench.tr("omen.mode_apply");
                                                primary: true;
                                                enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                                clicked => { Workbench.apply-omen-mode(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                plugin-fallback := Rectangle {
                    visible: Workbench.page == 3 && !Workbench.curve-open && Workbench.active-plugin-surface-kind != 0 && Workbench.active-plugin-surface-kind != 3;
                    VerticalLayout {
                        width: min(880px, parent.width);
                        x: (parent.width - self.width) / 2;
                        padding: 20px;
                        spacing: 14px;
                        alignment: start;

                        SectionTitle {
                            text: Workbench.active-plugin-title != "" ? Workbench.active-plugin-title : Workbench.tr("plugins.surface_unsupported_title");
                        }

                        SettingsCard {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text {
                                    text: Workbench.tr("plugins.surface_unsupported_body");
                                    color: Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                settings := Rectangle {
                    visible: Workbench.page == 4 && !Workbench.curve-open;
                    VerticalLayout {
                        spacing: 0px;

                        // 1. Non-scrolling structured header with canonical 4 sub-tabs
                        Rectangle {
                            vertical-stretch: 0;
                            height: settings-header.preferred-height;
                            settings-header := VerticalLayout {
                                width: min(880px, parent.width);
                                x: (parent.width - self.width) / 2;
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 20px;
                                padding-bottom: 12px;
                                spacing: 12px;

                                Text {
                                    text: Workbench.tr("settings.title");
                                    color: Theme.ink;
                                    font-size: 20px;
                                    font-weight: 600;
                                }

                                settings-tabs := SegmentedTabs {
                                    labels: [
                                        Workbench.tr("settings.tab_general"),
                                        Workbench.tr("settings.tab_plugins"),
                                        Workbench.tr("settings.tab_appearance"),
                                        Workbench.tr("settings.tab_hardware"),
                                    ];
                                    dirty-dots: Workbench.settings-tab-dirty;
                                    selected <=> Workbench.settings-tab;
                                    enabled: Workbench.confirm-kind == 0;
                                    changed(index) => {
                                        Workbench.settings-tab = index;
                                        settings-scroll.content-y = 0px;
                                    }
                                }
                            }
                        }

                        Hairline { }

                        // 2. Scrollable card-based content per sub-tab
                        settings-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width - 12px;
                            content-height: settings-content.preferred-height;
                            settings-content := VerticalLayout {
                                width: min(880px, parent.width);
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                                height: self.preferred-height;
                                padding: 20px;
                                spacing: 16px;

                                // --- Sub-tab 0: Allgemein ---
                                if Workbench.settings-tab == 0: VerticalLayout {
                                    spacing: 14px;

                                    Text {
                                        text: Workbench.tr("settings.card_app");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("settings.language");
                                                description: Workbench.tr("settings.restart_note");
                                                language := ComboBox {
                                                    width: Theme.field-width;
                                                    model: [Workbench.tr("settings.language_system"), "Deutsch", "English"];
                                                    current-index <=> Workbench.language-index;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    selected(value) => { Workbench.settings-changed(); }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.autostart");
                                                autostart := ToggleSwitch {
                                                    label: Workbench.tr("settings.autostart");
                                                    checked <=> Workbench.autostart;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    toggled(v) => { Workbench.settings-changed(); }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.start_in_tray");
                                                tray-start := ToggleSwitch {
                                                    label: Workbench.tr("settings.start_in_tray");
                                                    checked <=> Workbench.start-in-tray;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    toggled(v) => { Workbench.settings-changed(); }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.close");
                                                last: true;
                                                close-behavior := ComboBox {
                                                    width: Theme.field-width;
                                                    model: [Workbench.tr("settings.close_tray"), Workbench.tr("settings.close_exit")];
                                                    current-index <=> Workbench.close-index;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    selected(value) => { Workbench.settings-changed(); }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: Workbench.tr("settings.card_telemetry");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("telemetry.poll_rate");
                                                description: Workbench.tr("telemetry.poll_rate_desc");
                                                last: true;
                                                poll-rate := ComboBox {
                                                    width: Theme.field-width;
                                                    accessible-label: Workbench.tr("telemetry.poll_rate");
                                                    model: Workbench.poll-rate-choices;
                                                    current-index <=> Workbench.poll-rate-index;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    selected(value) => { Workbench.settings-changed(); }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: Workbench.tr("settings.card_behavior");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("settings.hold_preset");
                                                description: Workbench.tr("settings.startup_note");
                                                last: true;
                                                hold := ToggleSwitch {
                                                    label: Workbench.tr("settings.hold_preset");
                                                    checked <=> Workbench.hold-preset;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    toggled(v) => { Workbench.settings-changed(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // --- Sub-tab 1: Plugins ---
                                if Workbench.settings-tab == 1: VerticalLayout {
                                    spacing: 12px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            min-width: 0px;

                                            Text {
                                                text: Workbench.tr("plugins.title");
                                                color: Theme.ink;
                                                font-size: 15px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: Workbench.plugins-summary;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }

                                        plugins-reload := ActionButton {
                                            fixed-width: true;
                                            control-width: Theme.control-height;
                                            text: "";
                                            accessible-label: Workbench.tr("plugins.reload");
                                            enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                            clicked => { Workbench.reload-plugins(); }
                                            Image {
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("icons/refresh.svg");
                                                colorize: Theme.ink;
                                                accessible-role: none;
                                            }
                                        }

                                        plugins-open-folder := ActionButton {
                                            text: Workbench.tr("plugins.open_folder");
                                            enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                            clicked => { Workbench.open-plugins-folder(); }
                                        }

                                        plugins-add := ActionButton {
                                            text: Workbench.tr("plugins.add");
                                            primary: true;
                                            enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                            clicked => { Workbench.install-plugin(); }
                                        }
                                    }

                                    // Quiet storage path & instant-apply scope bar
                                    HorizontalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: Workbench.tr("plugins.storage_path") + ": " + Workbench.plugins-dir;
                                            color: Theme.quiet;
                                            font-family: "Consolas";
                                            font-size: 11px;
                                            overflow: elide;
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: Workbench.tr("plugins.instant_apply_note");
                                            color: Theme.muted;
                                            font-size: 11px;
                                            horizontal-stretch: 0;
                                        }
                                    }

                                    PluginTable {
                                        items: Workbench.plugins;
                                        interactive: !Workbench.busy && Workbench.confirm-kind == 0;
                                        toggled(id, next) => { Workbench.toggle-plugin(id, next); }
                                        remove-clicked(id) => { Workbench.remove-plugin(id); }
                                        add-clicked => { Workbench.install-plugin(); }
                                        open-folder-clicked => { Workbench.open-plugins-folder(); }
                                    }
                                }

                                // --- Sub-tab 2: Darstellung ---
                                if Workbench.settings-tab == 2: VerticalLayout {
                                    spacing: 14px;

                                    Text {
                                        text: Workbench.tr("settings.appearance");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            VerticalLayout {
                                                padding: 16px;
                                                spacing: 12px;
                                                palette-selector := ThemeGallery {
                                                    choices: Workbench.palette-choices;
                                                    selected: Workbench.palette-index;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    changed(index) => { Workbench.palette-changed(index); }
                                                }
                                            }

                                            Hairline { }

                                            SettingRow {
                                                label: Workbench.tr("settings.background");
                                                color-background := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.background");
                                                    value: Workbench.color-background;
                                                    swatch-color: Workbench.background-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(0); }
                                                }

                                                background-look := ComboBox {
                                                    control-width: 204px;
                                                    model: Workbench.color-look-choices;
                                                    current-index <=> Workbench.background-look-index;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    selected => { Workbench.look-changed(0, self.current-index); }
                                                }
                                            }

                                            if Workbench.background-look-index == Theme.look-gradient-index: SettingRow {
                                                label: Workbench.tr("settings.gradient_second_color");
                                                color-background-secondary := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.gradient_second_color");
                                                    value: Workbench.color-background-secondary;
                                                    swatch-color: Workbench.background-secondary-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(4); }
                                                }

                                                Rectangle {
                                                    width: 204px;
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.nav_background");
                                                color-nav-background := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.nav_background");
                                                    value: Workbench.color-nav-background;
                                                    swatch-color: Workbench.nav-background-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(7); }
                                                }

                                                nav-background-look := ComboBox {
                                                    control-width: 204px;
                                                    model: Workbench.color-look-choices;
                                                    current-index <=> Workbench.nav-background-look-index;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    selected => { Workbench.look-changed(3, self.current-index); }
                                                }
                                            }

                                            if Workbench.nav-background-look-index == Theme.look-gradient-index: SettingRow {
                                                label: Workbench.tr("settings.gradient_second_color");
                                                color-nav-background-secondary := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.gradient_second_color");
                                                    value: Workbench.color-nav-background-secondary;
                                                    swatch-color: Workbench.nav-background-secondary-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(8); }
                                                }

                                                Rectangle {
                                                    width: 204px;
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.foreground");
                                                color-foreground := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.foreground");
                                                    value: Workbench.color-foreground;
                                                    swatch-color: Workbench.foreground-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(1); }
                                                }

                                                foreground-look := ComboBox {
                                                    control-width: 204px;
                                                    model: Workbench.color-look-choices;
                                                    current-index <=> Workbench.foreground-look-index;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    selected => { Workbench.look-changed(1, self.current-index); }
                                                }
                                            }

                                            if Workbench.foreground-look-index == Theme.look-gradient-index: SettingRow {
                                                label: Workbench.tr("settings.gradient_second_color");
                                                color-foreground-secondary := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.gradient_second_color");
                                                    value: Workbench.color-foreground-secondary;
                                                    swatch-color: Workbench.foreground-secondary-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(5); }
                                                }

                                                Rectangle {
                                                    width: 204px;
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.accent");
                                                last: Workbench.accent-look-index != Theme.look-gradient-index;
                                                color-accent := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.accent");
                                                    value: Workbench.color-accent;
                                                    swatch-color: Workbench.accent-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(2); }
                                                }

                                                accent-look := ComboBox {
                                                    control-width: 204px;
                                                    model: Workbench.color-look-choices;
                                                    current-index <=> Workbench.accent-look-index;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    selected => { Workbench.look-changed(2, self.current-index); }
                                                }
                                            }

                                            if Workbench.accent-look-index == Theme.look-gradient-index: SettingRow {
                                                label: Workbench.tr("settings.gradient_second_color");
                                                last: true;
                                                color-accent-secondary := ColorField {
                                                    control-width: 192px;
                                                    text: Workbench.tr("settings.gradient_second_color");
                                                    value: Workbench.color-accent-secondary;
                                                    swatch-color: Workbench.accent-secondary-preview;
                                                    enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.open-color-picker(6); }
                                                }

                                                Rectangle {
                                                    width: 204px;
                                                }
                                            }
                                        }
                                    }

                                    if Workbench.appearance-error != "": CalloutBanner {
                                        text: Workbench.appearance-error;
                                        severity: 2;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: Workbench.tr("settings.palette_note");
                                            color: Theme.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        reset-appearance := ActionButton {
                                            text: Workbench.tr("settings.reset_palette");
                                            enabled: Workbench.settings-ready && !Workbench.busy && Workbench.confirm-kind == 0;
                                            clicked => { Workbench.reset-appearance(); }
                                        }
                                    }
                                }

                                // --- Sub-tab 3: Hardware ---
                                if Workbench.settings-tab == 3: VerticalLayout {
                                    spacing: 14px;

                                    Text {
                                        text: Workbench.tr("settings.card_service");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("settings.hw_service_title");
                                                description: Workbench.tr("settings.hw_service_desc");
                                                StatusPill {
                                                    min-width: 140px;
                                                    text: Workbench.hw-service-pill-text != "" ? Workbench.hw-service-pill-text : Workbench.tr("settings.hw_service_not_installed");
                                                    kind: Workbench.hw-service-pill-kind;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                padding-top: 10px;
                                                padding-bottom: 14px;
                                                spacing: 8px;
                                                alignment: end;

                                                ActionButton {
                                                    text: Workbench.hw-service-outdated ? Workbench.tr("settings.hw_service_update_btn")
                                                        : Workbench.hw-service-installed ? Workbench.tr("settings.hw_service_reinstall")
                                                        : Workbench.tr("settings.hw_service_install");
                                                    primary: !Workbench.hw-service-installed || Workbench.hw-service-outdated;
                                                    enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.hw-service-action("install"); }
                                                }

                                                ActionButton {
                                                    text: Workbench.hw-service-running ? Workbench.tr("settings.hw_service_stop") : Workbench.tr("settings.hw_service_start");
                                                    enabled: (Workbench.hw-service-installed && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.hw-service-action(Workbench.hw-service-running ? "stop" : "start"); }
                                                }

                                                ActionButton {
                                                    text: Workbench.tr("settings.hw_service_remove");
                                                    enabled: (Workbench.hw-service-installed && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.hw-service-action("remove"); }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: Workbench.tr("settings.card_gpu_power");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("settings.gpu_tgp_max");
                                                last: true;
                                                gpu-tgp-max := LineEdit {
                                                    accessible-label: Workbench.tr("settings.gpu_tgp_max");
                                                    text <=> Workbench.gpu-tgp-max-w;
                                                    unit: "W";
                                                    width: Theme.number-width;
                                                    horizontal-stretch: 0;
                                                    enabled: (Workbench.settings-ready && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    edited(text) => { Workbench.settings-changed(); }
                                                }
                                            }

                                            VerticalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                padding-bottom: 14px;
                                                CalloutBanner {
                                                    text: Workbench.gpu-tgp-max-error != "" ? Workbench.gpu-tgp-max-error : Workbench.tr("settings.gpu_tgp_max_warning");
                                                    severity: Workbench.gpu-tgp-max-error != "" ? 2 : 1;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: Workbench.tr("settings.device_defaults");
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                    }

                                    SettingsCard {
                                        VerticalLayout {
                                            spacing: 0px;

                                            SettingRow {
                                                label: Workbench.tr("settings.detect_defaults");
                                                description: Workbench.device-defaults-summary != "" ? Workbench.device-defaults-summary : Workbench.tr("settings.device_defaults_note");
                                                ActionButton {
                                                    text: Workbench.tr("settings.detect_defaults");
                                                    enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.detect-defaults(); }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("settings.hp_service_row");
                                                description: Workbench.tr("settings.hp_service_desc");
                                                ActionButton {
                                                    text: Workbench.hp-disabled ? Workbench.tr("ui.hp_restore") : Workbench.tr("settings.hp_service");
                                                    enabled: (Workbench.hp-available && !Workbench.busy) && Workbench.confirm-kind == 0;
                                                    clicked => { Workbench.hp-service(); }
                                                }
                                            }

                                            SettingRow {
                                                label: Workbench.tr("ui.about");
                                                last: true;
                                                ActionButton {
                                                    enabled: Workbench.confirm-kind == 0;
                                                    text: Workbench.tr("ui.about");
                                                    clicked => { Workbench.show-about(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Sticky Dirty Footer (rounded bottom corners match workspace 12px frame)
                        if Workbench.settings-dirty: Rectangle {
                            vertical-stretch: 0;
                            height: 58px;
                            border-bottom-left-radius: 11px;
                            border-bottom-right-radius: 11px;
                            background: Theme.surface-fill;

                            Hairline {
                                y: 0px;
                                width: parent.width;
                            }

                            HorizontalLayout {
                                width: min(880px, parent.width);
                                x: (parent.width - self.width) / 2;
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 11px;
                                padding-bottom: 11px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 4px;
                                        background: Theme.warning;
                                    }
                                }

                                Text {
                                    text: Workbench.tr("settings.unsaved_form_changes");
                                    color: Theme.ink;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                settings-discard := ActionButton {
                                    text: Workbench.tr("notice.discard");
                                    enabled: !Workbench.busy && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.discard-settings(); }
                                }

                                settings-save := ActionButton {
                                    text: Workbench.tr("preset.save");
                                    primary: true;
                                    enabled: (Workbench.settings-ready && Workbench.settings-dirty && Workbench.appearance-error == "" && Workbench.gpu-tgp-max-error == "" && !Workbench.busy) && Workbench.confirm-kind == 0;
                                    clicked => { Workbench.save-settings(); }
                                }
                            }
                        }
                    }
                }

                curve-editor := ScrollView {
                    content-width: self.visible-width - 12px;
                    visible: Workbench.curve-open;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            SectionTitle {
                                text: Workbench.curve-title;
                                horizontal-stretch: 1;
                            }

                            // Mouse and keyboard reference for the chart (also F1).
                            curve-help := ActionButton {
                                enabled: Workbench.confirm-kind == 0;
                                text: "i";
                                border-radius: self.height / 2;
                                accessible-label: Workbench.tr("curve.shortcuts");
                                clicked => { Workbench.curve-action("help"); }
                            }

                            ActionButton {
                                enabled: Workbench.confirm-kind == 0;
                                text: Workbench.tr("ui.discard_curve");
                                clicked => { Workbench.curve-action("discard"); }
                            }

                            ActionButton {
                                text: Workbench.tr("ui.use_curve");
                                primary: true;
                                enabled: (!Workbench.busy) && Workbench.confirm-kind == 0;
                                clicked => { Workbench.curve-action("save"); }
                            }
                        }

                        Text {
                            text: Workbench.tr(Workbench.curve-gpu ? "ui.curve_draft_note" : "fan_profile.curve_draft_note");
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        chart := CurveCanvas {
                            preferred-height: max(240px, curve-editor.visible-height - 186px);
                        }

                        // Legend, then the selected point with its exact value.
                        // Every other action is on the chart: mouse and hotkeys (i).
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 2px;
                                    background: Theme.accent;
                                }
                            }

                            Text {
                                text: Workbench.tr("ui.curve_draft");
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 1px;
                                    background: Theme.muted;
                                }
                            }

                            Text {
                                text: Workbench.tr(Workbench.curve-driver-reference ? "curve.legend_driver" : "ui.curve_reference");
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Workbench.has-selection ? Workbench.selection-label : "";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: Workbench.point-labels[Workbench.point-index];
                                color: Theme.ink;
                                font-family: "Consolas";
                                vertical-alignment: center;
                            }

                            if !Workbench.curve-gpu: LineEdit {
                                accessible-label: Workbench.curve-x-label;
                                text <=> Workbench.point-x;
                                enabled: Workbench.confirm-kind == 0;
                                width: 72px;
                                accepted => {
                                    Workbench.curve-action("set");
                                    chart.focus();
                                }
                            }

                            if !Workbench.curve-gpu: Text {
                                text: Workbench.curve-x-label;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }

                            // Enter sets the point; with a GPU selection it sets the
                            // whole selection to this frequency.
                            point-y := LineEdit {
                                accessible-label: Workbench.curve-y-label;
                                text <=> Workbench.point-y;
                                enabled: Workbench.confirm-kind == 0;
                                width: 80px;
                                accepted => {
                                    Workbench.curve-action(Workbench.curve-gpu && Workbench.has-selection ? "flatten" : "set");
                                    chart.focus();
                                }
                            }

                            Text {
                                text: Workbench.curve-y-label;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Subtle 1px top specular highlight inside inset canvas (Glass / Glossy / Metallic / Neon)
        Rectangle {
            x: 12px;
            y: 1px;
            width: max(0px, parent.width - 24px);
            height: 1px;
            background: Theme.surface-top-sheen;
        }
    }

    notification := NotificationPopup {
        visible: Workbench.notice-visible && Workbench.confirm-kind == 0;
        width: min(420px, parent.width - 236px);
        x: parent.width - self.width - 20px;
        y: max(50px, parent.height - self.height - 24px);
        title: Workbench.notice-title;
        text: Workbench.notice-text;
        failed: Workbench.notice-failed;
        dismissed => { Workbench.dismiss-notice(); }
        details => { Workbench.notice-details(); }
    }

    if Workbench.confirm-kind == 5: MessageDialog {
        title: Workbench.notice-title;
        text: Workbench.notice-text;
        closed => {
            Workbench.close-notice-details();
            if Workbench.curve-open && !Workbench.notice-visible { chart.focus(); } else { notification.focus-details(); }
        }
    }
    if Workbench.confirm-kind == 4: ColorPicker { }
    if (Workbench.confirm-kind > 0 && Workbench.confirm-kind < 4) || Workbench.confirm-kind == 7 || Workbench.confirm-kind == 8 || Workbench.confirm-kind == 9: ConfirmPrompt {
        kind: Workbench.confirm-kind;
        save-requested => { Workbench.confirm-save(); }
        accepted(value) => {
            Workbench.confirm(value);
            if Workbench.curve-open { chart.focus(); } else if Workbench.page < 2 { preset-name.focus(); } else { settings-button.focus(); }
        }
    }
}

export component AboutWindow inherits Window {
    in property <string> window-title;
    in property <string> version-text;
    in property <string> close-text;
    callback dismiss();
    title: root.window-title;
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 400px;
    preferred-height: 320px;
    min-width: 400px;
    min-height: 320px;
    background: Theme.nav-fill;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    private property <bool> dark-appearance: Theme.dark;
    changed dark-appearance => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    if Theme.has-nav-texture: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: Theme.nav-texture;
        image-fit: fill;
        accessible-role: none;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 38px;
        background: transparent;
        WindowMoveArea {
            x: 6px;
            width: parent.width - 52px;
            Text {
                x: 10px;
                text: root.window-title;
                color: Theme.nav-ink;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        CaptionButton {
            x: parent.width - 46px;
            kind: 2;
            text: root.close-text;
            clicked => { root.dismiss(); }
        }
    }

    Rectangle {
        x: 8px;
        y: 38px;
        width: max(0px, parent.width - 16px);
        height: max(0px, parent.height - 46px);
        border-radius: 10px;
        border-width: Theme.card-border-width;
        border-color: Theme.canvas-frame-border;
        background: Theme.canvas-fill;
        clip: true;

        if Theme.has-canvas-texture: Image {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            source: Theme.canvas-texture;
            image-fit: fill;
            accessible-role: none;
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            SectionTitle {
                text: "GLPH";
            }

            Text {
                text: root.version-text;
                color: Theme.muted;
            }

            AboutSlint {
                height: 110px;
            }

            ActionButton {
                text: root.close-text;
                clicked => { root.dismiss(); }
            }
        }
    }
}
