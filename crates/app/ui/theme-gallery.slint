import { Theme } from "theme.slint";
export struct PaletteChoice { name: string, canvas: color, nav: color, ink: color, accent: color }
export component ThemeGallery inherits Rectangle {
    in property <[PaletteChoice]> choices;
    in property <int> selected;
    in property <bool> enabled: true;
    callback changed(int);
    height: 78px;
    for choice[index] in root.choices: tile := Rectangle {
        x: index * (root.width + 8px) / max(1, root.choices.length);
        width: (root.width - (root.choices.length - 1) * 8px) / max(1, root.choices.length);
        height: parent.height;
        border-radius: 8px;
        clip: true;
        background: index == root.selected ? Theme.control-hover-fill : Theme.control-fill;
        border-width: focus.has-focus ? 1.5px : 1px;
        border-color: focus.has-focus ? Theme.ui-accent : index == root.selected ? Theme.ui-accent.with-alpha(0.38) : Theme.control-border;
        accessible-role: button;
        accessible-label: choice.name;
        accessible-enabled: root.enabled;
        accessible-checkable: true;
        accessible-checked: index == root.selected;
        accessible-action-default => { if root.enabled { root.changed(index); } }
        forward-focus: focus;

        // Mini two-tone Antigravity-style window preview (outer nav chrome + rounded inset canvas)
        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: 40px;
            border-radius: 5px;
            background: choice.nav;
            border-width: 1px;
            border-color: Theme.line.with-alpha(0.5);
            clip: true;

            // Mini nav rail active pill indicator
            Rectangle {
                x: 4px;
                y: 8px;
                width: 12px;
                height: 6px;
                border-radius: 2px;
                background: choice.accent.with-alpha(0.35);
                border-width: 1px;
                border-color: choice.accent;
            }
            Rectangle {
                x: 4px;
                y: 18px;
                width: 10px;
                height: 3px;
                border-radius: 1px;
                background: choice.ink.with-alpha(0.30);
            }
            Rectangle {
                x: 4px;
                y: 25px;
                width: 9px;
                height: 3px;
                border-radius: 1px;
                background: choice.ink.with-alpha(0.22);
            }

            // Mini inset rounded canvas
            Rectangle {
                x: 20px;
                y: 5px;
                width: max(20px, parent.width - 23px);
                height: parent.height - 8px;
                border-radius: 4px;
                background: choice.canvas;
                border-width: 1px;
                border-color: choice.ink.with-alpha(0.14);

                Text {
                    x: 7px;
                    text: "Aa";
                    font-size: 14px;
                    font-weight: 600;
                    color: choice.ink;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    x: parent.width - 26px;
                    y: 10px;
                    width: 20px;
                    height: 11px;
                    border-radius: 3px;
                    background: choice.accent;
                }
            }
        }

        Text {
            y: 48px;
            height: 26px;
            text: choice.name;
            color: root.enabled ? Theme.ink : Theme.quiet;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: index == root.selected ? 600 : 400;
            accessible-role: none;
        }

        TouchArea {
            enabled: root.enabled;
            clicked => { focus.focus(); root.changed(index); }
        }

        focus := FocusScope {
            width: 0px;
            enabled: root.enabled;
            key-pressed(e) => { if e.text == " " || e.text == Key.Return { root.changed(index); return accept; } return reject; }
        }
    }
}
