import { Theme } from "theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    out property <bool> keyboard-focus: focus.has-focus;
    out property <bool> hovered: area.has-hover;
    callback clicked();
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    in property <bool> fixed-width: root.text == "+" || root.text == "−" || root.text == "i" || root.text == "";
    in property <length> control-width: root.text == "+" || root.text == "−" || root.text == "i" ? Theme.control-height : Theme.action-width;
    min-width: root.fixed-width ? root.control-width : max(root.control-width, label.preferred-width + 24px);
    preferred-width: self.min-width;
    max-width: root.fixed-width ? root.control-width : 1000px;
    min-height: Theme.control-height;
    max-height: Theme.control-height;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 7px;
    clip: true;
    // Pressed text retains one of the validated foreground/background pairs.
    background: !root.enabled ? Theme.surface-fill
              : root.primary ? (area.pressed ? Theme.accent-pressed-fill : area.has-hover ? Theme.accent-hover-fill : Theme.accent-fill)
              : area.pressed ? Theme.control-pressed-fill
              : area.has-hover ? Theme.control-hover-fill
              : Theme.control-fill;
    border-width: root.enabled && (area.pressed || focus.has-focus) ? 1.5px : Theme.card-border-width;
    border-color: root.enabled && (area.pressed || focus.has-focus) ? (root.primary ? Theme.on-accent : Theme.ui-accent)
                : !root.enabled ? Theme.line.with-alpha(0.45)
                : root.primary ? Theme.accent-border
                : Theme.control-border;
    animate background, border-color { duration: Theme.reduce-motion ? 0ms : 140ms; easing: ease-out; }

    label := Text {
        x: 10px;
        y: 0px;
        width: max(0px, parent.width - 20px);
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.quiet : root.primary ? Theme.on-accent : Theme.ink;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    @children
    area := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
}

// Round "i" that opens the explanation of a row. The circle is 20 px; the
// pointer and keyboard target keeps the control height.
export component InfoButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    min-width: Theme.info-width;
    max-width: Theme.info-width;
    min-height: Theme.control-height;
    max-height: Theme.control-height;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: !root.enabled ? Theme.line : focus.has-focus || root.active ? Theme.accent : area.has-hover ? Theme.ink : Theme.muted;
        background: area.pressed || area.has-hover || root.active ? Theme.hover : transparent;
        Text {
            width: parent.width;
            height: parent.height;
            text: "i";
            color: root.enabled ? Theme.ink : Theme.quiet;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component SegmentedTabs inherits Rectangle {
    in property <[string]> labels;
    in property <[bool]> dirty-dots;
    in property <bool> enabled: true;
    in-out property <int> selected;
    callback changed(int);
    height: Theme.control-height;
    background: Theme.surface-fill;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.surface-border;
    clip: true;
    // Selection and keyboard outline belong to the same equal-sized control.
    // An independent moving background used to disagree with intrinsic widths.
    for title[index] in root.labels: tab := ActionButton {
        enabled: root.enabled;
        fixed-width: true;
        x: index * root.width / max(1, root.labels.length);
        width: root.width / max(1, root.labels.length);
        control-width: root.width / max(1, root.labels.length);
        text: title;
        border-radius: 7px;
        background: index == root.selected ? Theme.control-hover-fill
                  : self.hovered && root.enabled ? Theme.control-fill
                  : transparent;
        border-color: transparent;
        accessible-item-selectable: true;
        accessible-item-selected: index == root.selected;
        clicked => { root.changed(index); }
        Rectangle {
            visible: index < root.dirty-dots.length && root.dirty-dots[index];
            x: parent.width - 12px;
            y: 7px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.warning;
        }
    }
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component SettingsCard inherits Rectangle {
    background: Theme.surface-fill;
    border-radius: 10px;
    border-width: Theme.card-border-width;
    border-color: Theme.surface-border;
    clip: true;

    if Theme.has-surface-texture: Image {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: max(0px, parent.height - 2px);
        source: Theme.surface-texture;
        image-fit: fill;
        accessible-role: none;
    }

    // Subtle 1px inner top specular highlight for Glass / Glossy / Metallic / Neon
    Rectangle {
        x: 10px;
        y: 1px;
        width: max(0px, parent.width - 20px);
        height: 1px;
        background: Theme.surface-top-sheen;
    }

    @children
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> last;
    height: max(54px, row-layout.preferred-height);
    row-layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 13px;
                font-weight: 500;
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            horizontal-stretch: 0;
            @children
        }
    }

    if !root.last: Hairline {
        x: 16px;
        y: parent.height - 1px;
        width: max(0px, parent.width - 32px);
    }
}

export component CalloutBanner inherits Rectangle {
    in property <string> text;
    // 0 = info/muted, 1 = warning, 2 = error, 3 = good
    in property <int> severity: 1;
    private property <color> tone: root.severity == 2 ? Theme.error
                                 : root.severity == 3 ? Theme.good
                                 : root.severity == 1 ? Theme.warning
                                 : Theme.accent;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.55);
    background: root.tone.with-alpha(0.14);
    height: banner-layout.preferred-height;
    banner-layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 5px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
            }
        }

        Text {
            text: root.text;
            color: Theme.ink;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    // 0 = active (good), 1 = inactive (muted), 2 = incompatible/warning, 3 = error
    in property <int> kind: 1;
    private property <color> tone: root.kind == 0 ? Theme.good
                                 : root.kind == 2 ? Theme.warning
                                 : root.kind == 3 ? Theme.error
                                 : Theme.muted;
    min-width: 104px;
    preferred-width: max(self.min-width, pill-layout.preferred-width);
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.kind == 1 ? Theme.control-border : root.tone.with-alpha(0.55);
    background: root.kind == 1 ? Theme.control : root.tone.with-alpha(0.14);
    pill-layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.kind == 1 ? Theme.quiet : root.tone;
            }
        }

        Text {
            text: root.text;
            color: root.kind == 1 ? Theme.muted : root.tone;
            font-size: 12px;
            font-weight: root.kind == 0 ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component SectionTitle inherits Text {
    color: Theme.ink-fill;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.25px;
    vertical-alignment: center;
    height: 32px;
}

export component SectionHeader inherits Rectangle {
    in property <string> text;
    in property <bool> expanded;
    callback clicked();
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: Theme.control-height;
    background: area.has-hover ? Theme.control-hover-fill : Theme.surface-fill;
    border-radius: 7px;
    clip: true;
    border-width: focus.has-focus ? 1.5px : Theme.card-border-width;
    border-color: focus.has-focus ? Theme.ui-accent : Theme.surface-border;
    animate background, border-color { duration: Theme.reduce-motion ? 0ms : 140ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: Theme.ink;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Path {
            y: 14px;
            width: 12px;
            height: 8px;
            stroke: Theme.muted;
            stroke-width: 1.5px;
            commands: root.expanded ? "M 1 6 L 6 1 L 11 6" : "M 1 1 L 6 6 L 11 1";
        }
    }

    area := TouchArea {
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
}
