import { Theme } from "theme.slint";
export component ColorField inherits Rectangle {
    in property <string> value;
    in property <string> text;
    in property <color> swatch-color;
    in property <bool> mixed;
    in property <bool> enabled: true;
    in property <length> control-width: Theme.field-width;
    callback clicked();
    forward-focus: focus;
    height: Theme.control-height;
    width: root.control-width;
    horizontal-stretch: 0;
    background: area.has-hover && root.enabled ? Theme.control-hover-fill : Theme.control-fill;
    border-radius: 6px;
    clip: true;
    border-width: focus.has-focus ? 1.5px : Theme.card-border-width;
    border-color: focus.has-focus ? Theme.accent : Theme.control-border;
    animate background, border-color { duration: Theme.reduce-motion ? 0ms : 150ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-value: root.value;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Rectangle {
        visible: root.enabled;
        x: 6px;
        y: 1px;
        width: max(0px, parent.width - 12px);
        height: 1px;
        background: Theme.surface-top-sheen;
    }

    Rectangle {
        x: 10px;
        y: 8px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: root.swatch-color;
        border-width: 1px;
        border-color: Theme.muted;
    }

    Text {
        x: 42px;
        width: parent.width - 82px;
        text: root.mixed ? Theme.tr("lighting.mixed") : root.value;
        color: root.enabled ? Theme.ink : Theme.quiet;
        vertical-alignment: center;
        font-family: root.mixed ? "Segoe UI" : "Consolas";
        accessible-role: none;
    }

    Image {
        x: parent.width - 30px;
        y: 9px;
        width: 18px;
        height: 18px;
        source: @image-url("icons/palette.svg");
        colorize: root.enabled ? Theme.muted : Theme.quiet;
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
}
