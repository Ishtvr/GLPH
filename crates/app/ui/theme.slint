export global Theme {
    pure callback tr(string) -> string;
    in property <bool> dark: true;
    in property <bool> reduce-motion: false;
    in property <color> canvas: #242424;
    in property <color> surface: #2C2C2D;
    in property <color> control: #323233;
    in property <color> hover: #3A3A3B;
    in property <color> line: #363637;
    in property <color> ink: #F2F3F5;
    in property <color> muted: #AFB2BC;
    in property <color> quiet: #787A80;
    in property <color> accent: #000000;
    in property <color> on-accent: #FFFFFF;
    // Contrast-safe accent for toggles, sliders, checkboxes & focus rings (readable even when accent == #000000)
    in property <color> ui-accent: #B8B8BA;
    in property <color> on-ui-accent: #000000;

    // Dedicated Secondary / Navigation Chrome channel (Antigravity outer shell)
    in property <color> nav: #000000;
    in property <bool> nav-dark: true;
    in property <color> nav-ink: #F2F3F5;
    in property <color> nav-muted: #9B9DA3;
    in property <color> nav-quiet: #64666C;
    in property <color> nav-line: #18181A;
    in property <color> nav-hover: #1C1C1E;
    in property <color> nav-accent: #D0D2D6;

    // Per-channel visual Look: 0 = Standard, 1 = Gradient (Farbverlauf)
    out property <int> look-gradient-index: 1;
    in property <int> background-look: 0;
    in property <int> nav-background-look: 0;
    in property <int> foreground-look: 0;
    in property <int> accent-look: 0;

    in property <color> canvas-secondary: #14213D;
    in property <color> nav-secondary: #1B2845;
    in property <color> ink-secondary: #A8B0C2;
    in property <color> accent-secondary: #A855F7;

    // Smooth 135° gradient textures (SDF-rounded corners, zero edge shadows)
    in property <image> nav-texture;
    in property <image> canvas-texture;
    in property <image> surface-texture;

    out property <bool> has-nav-texture: nav-background-look == 1;
    out property <bool> has-canvas-texture: background-look == 1;
    out property <bool> has-surface-texture: background-look == 1;

    // Harmonized Telemetry chart tokens
    in property <color> chart-cpu: #D0D2D6;
    in property <color> chart-gpu: #E8A66E;
    in property <color> chart-grid: #343436;

    // Antigravity minimal surfaces:
    // - Zero linear-gradient on rounded Rectangles (pixel-perfect corners everywhere).
    // - Whisper-quiet hairline borders, subtle tonal selection lift without heavy boxes.

    out property <color> nav-fill: nav;

    // Selected navigation item: Antigravity-style clean borderless tonal highlight pill
    out property <color> nav-selected-fill: nav-hover;
    out property <color> nav-selected-border: transparent;

    // Inset rounded canvas border — barely-there Antigravity hairline
    out property <color> canvas-frame-border: line.with-alpha(dark ? 0.55 : 0.75);

    out property <color> canvas-fill: canvas;
    out property <color> surface-fill: surface;
    out property <color> surface-border: line.with-alpha(dark ? 0.65 : 0.78);
    out property <color> surface-top-sheen: transparent;

    out property <color> control-fill: control;
    out property <color> control-hover-fill: hover;
    out property <color> control-pressed-fill:
        dark ? control.mix(#000000, 0.76) : control.mix(#000000, 0.92);
    out property <color> control-border: line.with-alpha(dark ? 0.72 : 0.85);

    out property <color> popup-fill: surface;
    out property <color> popup-border: line.with-alpha(dark ? 0.85 : 0.90);

    // Primary button fills (honors exact user accent, e.g. sleek monochrome #000000 with subtle rim)
    out property <color> accent-fill:
        accent-look == 1 ? accent.mix(accent-secondary, 0.72) : accent;
    out property <color> accent-hover-fill:
        accent-fill.mix(on-accent, 0.88);
    out property <color> accent-pressed-fill:
        accent-fill.mix(#000000, 0.84);
    out property <color> accent-border:
        dark ? ink.with-alpha(0.16) : ink.with-alpha(0.14);

    out property <color> ink-fill: ink;
    out property <color> chart-plot-fill: canvas.mix(surface, 0.62);

    out property <color> scrim: dark ? #000000A6 : #10131C6E;
    out property <length> card-border-width: 1px;

    out property <color> good: dark ? #71D5A6 : #147347;
    out property <color> warning: dark ? #E5C18A : #765000;
    out property <color> error: dark ? #F3A1AF : #A21635;
    out property <length> control-height: 36px;
    out property <length> field-width: 276px;
    out property <length> number-width: self.field-width;
    out property <length> row-height: 48px;
    out property <length> info-width: 28px;
    out property <length> action-width: 128px;
    out property <length> workspace-width: 1280px;
}
